// Configuração do Worker no Cloudflare (lida pelo deploy automático a cada push na main).
{
  "name": "ficha-hpt",
  "main": "worker.js",
  "compatibility_date": "2025-02-24",
  // O site: tudo que está em docs/ é servido direto; /api/* cai no worker.js
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS"
  },
  // Senha do admin e chave do YouTube: NÃO ficam aqui. Cadastre no Cloudflare como Secret
  // ADMIN_SENHA e YOUTUBE_API_KEY (Worker → Settings → Variables and Secrets).
  // keep_vars: o deploy automático não apaga as variáveis cadastradas no painel.
  "keep_vars": true,
  // Onde ficam os dados de cada usuário
  "kv_namespaces": [
    {
      "binding": "FICHA_KV",
      "id": "43ca85a1bbd542ce9bc5a0a629676bd9"
    }
  ]
}
